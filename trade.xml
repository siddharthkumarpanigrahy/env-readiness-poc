        <EurexOTCEntryXML:EurexLEId/>
        <EurexOTCEntryXML:globalLEId href="party2"/>
        <EurexOTCEntryXML:srcSysLEId/>
        <EurexOTCEntryXML:internalReference>{{INTERNAL_REFERENCE}}</EurexOTCEntryXML:internalReference>
